# ===========================================
# Portfolio Website Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ----- Authentication -----
# Shared JWT secret (must match between auth-service and backend)
# Generate with: openssl rand -base64 32
AUTH_JWT_SECRET=your_jwt_secret_here_min_32_chars

# Better Auth configuration
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3001

# ----- CORS Configuration -----
CORS_ORIGINS=http://localhost:3000

# ----- Service URLs -----
FRONTEND_URL=http://localhost:3000

# ----- Optional: Google OAuth -----
# Set up Google OAuth at: https://console.developers.google.com/
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# ----- pgAdmin (Development Only) -----
# Required when using: docker compose --profile pgadmin up
PGADMIN_DEFAULT_EMAIL=admin@portfolio.com
PGADMIN_DEFAULT_PASSWORD=admin
